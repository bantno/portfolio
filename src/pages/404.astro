---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="404 — Brian Epstein">
  <Nav />
  <main class="notfound">
    <div class="container">
      <p class="code">// 404</p>
      <h1 class="headline">Signal lost.</h1>
      <p class="sub">That page isn't on the map. Let's get you back to known coordinates.</p>
      <div class="links">
        <a href={`${base}/`} class="primary">Return Home</a>
        <a href={`${base}/about`}>About</a>
        <a href={`${base}/career`}>Career</a>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .notfound {
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding-top: calc(56px + var(--space-xl));
    padding-bottom: var(--space-2xl);
  }

  .code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.15em;
    margin-bottom: var(--space-md);
  }

  .headline {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 800;
    color: var(--color-text-bright);
    line-height: 1.05;
    margin-bottom: var(--space-md);
  }

  .sub {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 40ch;
    margin-bottom: var(--space-xl);
    line-height: 1.6;
  }

  .links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .links a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }
  .links a:hover {
    color: var(--color-text-bright);
  }

  .links .primary {
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    padding: 0.6rem 1.2rem;
    transition: background 0.2s, color 0.2s;
  }
  .links .primary:hover {
    background: var(--color-accent);
    color: var(--color-bg);
  }
</style>
