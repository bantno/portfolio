---
// The about content now lives on the landing page — redirect old links there.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const target = `${base}/#about`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Brian Epstein — About</title>
  </head>
  <body>
    <p>This page has moved to <a href={target}>the home page</a>.</p>
  </body>
</html>
