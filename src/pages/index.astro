---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const sorted = projects
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const isVideoFile = (src: string) => /\.(mp4|webm|mov|ogg)$/i.test(src);

const statusClass: Record<string, string> = {
  Active: "active",
  Complete: "complete",
  "In Development": "dev",
};
---

<Base>
  <!-- Flight-trace scroll progress bar -->
  <div id="trace-bar" aria-hidden="true">
    <svg viewBox="0 0 1000 30" preserveAspectRatio="none">
      <path id="trace-path" d="M0,22 L60,22 L100,9 L160,9 L200,18 L260,5 L320,15 L380,4 L440,13 L500,7 L560,16 L620,5 L680,14 L740,4 L800,13 L860,7 L920,16 L1000,9"/>
      <path id="trace-fill" d="M0,22 L60,22 L100,9 L160,9 L200,18 L260,5 L320,15 L380,4 L440,13 L500,7 L560,16 L620,5 L680,14 L740,4 L800,13 L860,7 L920,16 L1000,9"/>
    </svg>
  </div>

  <Nav />
  <main>
    <div class="container">
      <!-- Hero -->
      <section class="hero">
        <p class="eyebrow">Atlanta, GA · Georgia Tech · PhD Candidate</p>
        <h1 class="hero-title">Brian Epstein</h1>
        <p class="role-line">
          PhD candidate building <strong>autonomous systems that bridge simulation and the real world</strong> — from a solar-powered seaplane UAV to championship combat robots, plus the planners, estimators, and control loops that run them.
        </p>
        <div class="stat-strip">
          <div class="stat"><div class="k">Program</div><div class="v">Ph.D. Mechanical Eng.</div></div>
          <div class="stat"><div class="k">GPA</div><div class="v">4.00 / 4.00</div></div>
          <div class="stat"><div class="k">Graduation</div><div class="v">Fall 2026</div></div>
          <div class="stat"><div class="k">Focus</div><div class="v">Autonomy &amp; Controls</div></div>
        </div>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#projects">View projects →</a>
          <a class="btn btn-ghost" href={`${BASE}/resume.pdf`} target="_blank" rel="noopener">Download résumé (PDF)</a>
        </div>
      </section>

      <!-- 01 — About -->
      <section class="block" id="about">
        <div class="sec-head"><h2>About</h2><span class="sec-tag">01 — Overview</span></div>
        <div class="about-grid">
          <div class="about-text">
            <p>
              I'm a PhD candidate in Mechanical Engineering at Georgia Tech, graduating Fall 2026. My work spans the full design cycle — from mathematical modeling and simulation to hardware fabrication and flight testing. I specialize in autonomous systems and controls, with particular depth in aerial vehicles and energy-aware mission planning.
            </p>
            <p>
              My research philosophy centers on closing the gap between simulation and the real world. Every system I build gets tested in hardware, every algorithm gets validated against physical data, and every design decision is driven by what actually works in the field.
            </p>
            <p>
              Outside the lab, I've spent eight years in competitive combat robotics through Georgia Tech's RoboJackets. Chonki — the robot I lead — became NHRL's first collegiate featherweight champion and earned over 50 million social media views. The same iterative design mindset that wins championships drives my research.
            </p>
          </div>
          <div class="about-side">
            <img src={`${BASE}/images/headshot.jpg`} alt="Brian Epstein" class="headshot" />
            <div class="edu-card">
              <div class="school">Georgia Institute of Technology</div>
              <div class="degree-row">
                <span>Ph.D. Mechanical Engineering — Autonomy &amp; Controls</span>
                <span class="degree-when">2022 – 2026</span>
              </div>
              <div class="degree-row">
                <span>M.S. Mechanical Engineering — Controls &amp; Robotics, Mechatronics &amp; Design</span>
                <span class="degree-when">2022 – 2024</span>
              </div>
              <div class="degree-row">
                <span>B.S. Mechanical Engineering — Minor in Robotics, Highest Honors</span>
                <span class="degree-when">2018 – 2022</span>
              </div>
              <div class="edu-meta">
                <span>GPA <b>4.00 / 4.00</b></span>
                <span>Graduating <b>Fall 2026</b></span>
              </div>
            </div>
          </div>
        </div>

        <div class="skill-grid">
          <div class="skill-card">
            <h4>Fabrication</h4>
            <ul><li>Waterjet</li><li>Laser Cutter</li><li>3D Printing</li><li>CNC / Manual Machining</li><li>Soldering &amp; Wiring Harnesses</li><li>Environmental Sealing</li><li>Payload Integration</li></ul>
          </div>
          <div class="skill-card">
            <h4>Software</h4>
            <ul><li>Python</li><li>MATLAB / Simulink</li><li>C / C++</li><li>ROS2</li><li>PX4</li><li>Gazebo / JSBSim</li><li>LabVIEW</li></ul>
          </div>
          <div class="skill-card">
            <h4>CAD &amp; Analysis</h4>
            <ul><li>SolidWorks</li><li>Autodesk Inventor</li><li>Fusion 360</li><li>PTC Creo</li><li>OpenVSP / VSPAERO</li></ul>
          </div>
          <div class="skill-card">
            <h4>Focus Areas</h4>
            <ul><li>Flight Testing</li><li>State Estimation</li><li>Optimal Control</li><li>MDP Mission Planning</li><li>Mechatronic Design</li></ul>
          </div>
        </div>
      </section>

      <!-- 02 — Projects -->
      <section class="block" id="projects">
        <div class="sec-head"><h2>Projects</h2><span class="sec-tag">02 — Systems</span></div>
        <div class="project-grid">
          {sorted.map((project, i) => {
            const d = project.data;
            const isBrief = d.tier === "brief";
            const isProminent = d.tier === "flagship" || d.tier === "featured";
            const href = isBrief ? undefined : `${BASE}/projects/${project.id.replace(/\.mdx?$/, "")}`;
            const Tag = isBrief ? "div" : "a";

            return (
              <Tag
                href={href}
                class:list={[
                  "card",
                  `tier-${d.tier}`,
                  { "card-brief": isBrief, "card-prominent": isProminent },
                ]}
                style={`animation-delay: ${i * 0.08}s`}
              >
                {/* Media area */}
                <div class="card-media">
                  {d.video ? (
                    <iframe
                      src={d.video}
                      title={d.title}
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                      loading="lazy"
                    />
                  ) : d.thumbnail && isVideoFile(d.thumbnail) ? (
                    <video
                      src={`${BASE}${d.thumbnail}`}
                      autoplay
                      loop
                      muted
                      playsinline
                      preload="metadata"
                    />
                  ) : d.thumbnail ? (
                    <img src={`${BASE}${d.thumbnail}`} alt={d.title} loading="lazy" />
                  ) : (
                    <div class="media-placeholder">
                      <span class="placeholder-icon">⬡</span>
                      <span class="placeholder-text">{d.domain}</span>
                    </div>
                  )}
                </div>

                {/* Card body */}
                <div class="card-body">
                  <div class="card-header">
                    <span class={`status-badge ${statusClass[d.status]}`}>{d.status}</span>
                    <span class="domain-label">{d.domain}</span>
                    {isBrief && <span class="brief-label">Ongoing Research</span>}
                  </div>
                  <h3 class="card-title">{d.title}</h3>
                  {isBrief && <p class="card-date">{d.date_range}</p>}
                  <p class="card-desc">{d.summary}</p>
                  <div class="metrics">
                    {d.metrics.map((m) => (
                      <div class="metric">
                        <span class="metric-value">{m.value}</span>
                        <span class="metric-label">{m.label}</span>
                      </div>
                    ))}
                  </div>
                  <div class="card-tags">
                    {d.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                </div>
              </Tag>
            );
          })}
        </div>
      </section>

      <!-- 03 — Publications -->
      <section class="block" id="publications">
        <div class="sec-head"><h2>Publications</h2><span class="sec-tag">03 — Papers</span></div>
        <ul class="pub-list">
          <li class="pub-entry">
            B. Epstein and J. D. Rogers, "Optimal flight planning for marine mammal surveillance from a seaplane UAV," <em>AIAA Journal of Aircraft</em> (in press).
          </li>
          <li class="pub-entry">
            B. Epstein and J. D. Rogers, "Conceptual Design of a Low-Altitude Solar Powered Seaplane for Oceanic Monitoring," <em>AIAA AVIATION FORUM AND ASCEND 2024</em>.
          </li>
          <li class="pub-entry">
            Ward, D, Epstein, B, Tiziani, L, &amp; Hammond, FL, III. "Optimal Design of a Mechatronic Lever Arm for Pneumatic Exoskeleton: Design and Validation." <em>2021 Design of Medical Devices Conference</em>.
          </li>
        </ul>
      </section>

      <!-- 04 — Contact -->
      <section class="block" id="contact">
        <div class="contact-grid">
          <div>
            <h2 class="contact-heading">Let's build something that works in the real world.</h2>
            <p class="contact-lead">Open to roles and collaborations in robotics, controls, and flight test. Reach out any of these ways.</p>
          </div>
          <ul class="contact-list">
            <li><span class="k">Email</span><a href="mailto:bepstein8@gatech.edu">bepstein8@gatech.edu</a></li>
            <li><span class="k">LinkedIn</span><a href="https://linkedin.com/in/br-epstein" target="_blank" rel="noopener noreferrer">/in/br-epstein</a></li>
            <li><span class="k">GitHub</span><a href="https://github.com/bantno" target="_blank" rel="noopener noreferrer">github.com/bantno</a></li>
            <li><span class="k">Location</span><span>Atlanta, GA</span></li>
            <li><span class="k">Résumé</span><a href={`${BASE}/resume.pdf`} target="_blank" rel="noopener">Download PDF</a></li>
          </ul>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Base>

<script>
  // flight-trace scroll progress
  const fill = document.getElementById("trace-fill") as SVGPathElement | null;
  if (fill) {
    const total = fill.getTotalLength();
    fill.style.strokeDasharray = String(total);
    fill.style.strokeDashoffset = String(total);
    const onScroll = () => {
      const doc = document.documentElement;
      const scrollTop = doc.scrollTop || document.body.scrollTop;
      const scrollHeight = doc.scrollHeight - doc.clientHeight || 1;
      const pct = Math.min(Math.max(scrollTop / scrollHeight, 0), 1);
      fill.style.strokeDashoffset = String(total - total * pct);
    };
    document.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>

<style is:global>
  /* Trace bar sits above the fixed nav on this page only */
  body:has(#trace-bar) .nav {
    top: 30px;
  }
</style>

<style>
  #trace-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 30px;
    z-index: 200;
    background: rgba(10, 14, 26, 0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--color-border);
  }
  #trace-bar svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  #trace-path {
    fill: none;
    stroke: var(--color-border-bright);
    stroke-width: 1.25;
  }
  #trace-fill {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.75;
  }

  /* ── Hero ──────────────────────────────────────────────── */
  .hero {
    padding-top: calc(86px + var(--space-xl));
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-xl);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-status-complete);
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .eyebrow::before {
    content: "";
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(232, 197, 71, 0.18);
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 800;
    line-height: 1.03;
    letter-spacing: -0.01em;
    color: var(--color-text-bright);
    max-width: 16ch;
  }

  .role-line {
    font-size: clamp(1.02rem, 2vw, 1.25rem);
    color: var(--color-text);
    margin-top: 18px;
    max-width: 56ch;
    line-height: 1.55;
  }
  .role-line strong {
    color: var(--color-text-bright);
    font-weight: 600;
  }

  .stat-strip {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }
  .stat {
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 16px 18px;
    background: var(--color-bg-raised);
  }
  .stat .k {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-text-muted);
    margin-bottom: 8px;
  }
  .stat .v {
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--color-text-bright);
  }

  .hero-cta {
    margin-top: 36px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .btn {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 12px 20px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: transform 0.15s ease, background 0.15s, color 0.15s, border-color 0.15s;
    border-radius: var(--radius);
  }
  .btn-primary {
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .btn-primary:hover {
    background: var(--color-text-bright);
    color: var(--color-bg);
    transform: translateY(-1px);
  }
  .btn-ghost {
    border: 1px solid var(--color-border-bright);
    color: var(--color-text);
  }
  .btn-ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  /* ── Section scaffolding ───────────────────────────────── */
  .block {
    padding-bottom: var(--space-xl);
    margin-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 110px;
  }
  .block:last-of-type {
    border-bottom: none;
  }

  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 38px;
    gap: 20px;
    flex-wrap: wrap;
  }
  .sec-head h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 700;
    color: var(--color-text-bright);
  }
  .sec-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  /* ── About ─────────────────────────────────────────────── */
  .about-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 60px;
  }
  .about-text p {
    color: var(--color-text);
    font-size: 1.02rem;
    max-width: 56ch;
    line-height: 1.7;
  }
  .about-text p + p {
    margin-top: 16px;
  }

  .about-side {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .headshot {
    width: 100%;
    max-width: 260px;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  .edu-card {
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
    padding: 24px;
    border-radius: var(--radius);
  }
  .edu-card .school {
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--color-text-bright);
  }
  .degree-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    color: var(--color-text);
    margin-top: 10px;
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .degree-when {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .edu-meta {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px dashed var(--color-border-bright);
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-text-muted);
  }
  .edu-meta b {
    color: var(--color-text-bright);
    font-weight: 600;
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    margin-top: 60px;
  }
  .skill-card {
    background: var(--color-bg-card);
    padding: 24px;
  }
  .skill-card h4 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-status-complete);
    margin-bottom: 14px;
  }
  .skill-card ul {
    list-style: none;
  }
  .skill-card li {
    font-size: 0.88rem;
    color: var(--color-text);
    padding: 6px 0;
    border-top: 1px solid var(--color-border);
  }
  .skill-card li:first-child {
    border-top: none;
  }

  /* ── Project grid ──────────────────────────────────────── */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: var(--space-lg);
  }

  .card-prominent {
    grid-column: span 1;
  }

  .card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.3s, transform 0.3s;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  a.card:hover {
    border-color: var(--color-border-bright);
    transform: translateY(-2px);
  }

  .card-brief {
    opacity: 0.75;
    cursor: default;
  }
  .card-brief:hover {
    transform: none;
    border-color: var(--color-border);
  }

  .card-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-raised);
    border-bottom: 1px solid var(--color-border);
  }
  .card-media iframe,
  .card-media video,
  .card-media img {
    width: 100%;
    height: 100%;
    border: none;
    object-fit: cover;
    display: block;
  }

  .media-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    color: var(--color-text-muted);
  }
  .placeholder-icon {
    font-size: 2rem;
    opacity: 0.3;
  }
  .placeholder-text {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0.4;
  }

  .card-body {
    padding: var(--space-lg);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
  }

  .status-badge {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 2px 8px;
    border-radius: 3px;
  }
  .status-badge.active {
    background: rgba(71, 232, 120, 0.1);
    color: var(--color-status-active);
    border: 1px solid rgba(71, 232, 120, 0.25);
  }
  .status-badge.complete {
    background: rgba(71, 136, 232, 0.1);
    color: var(--color-status-complete);
    border: 1px solid rgba(71, 136, 232, 0.25);
  }
  .status-badge.dev {
    background: rgba(232, 166, 71, 0.1);
    color: var(--color-status-dev);
    border: 1px solid rgba(232, 166, 71, 0.25);
  }

  .domain-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .brief-label {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--color-status-dev);
    background: rgba(232, 166, 71, 0.1);
    border: 1px solid rgba(232, 166, 71, 0.2);
    padding: 1px 6px;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-bright);
    margin-bottom: var(--space-sm);
    line-height: 1.3;
  }

  .card-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--color-text);
    margin-bottom: var(--space-md);
    line-height: 1.6;
  }

  .metrics {
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .metric-value {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent);
  }
  .metric-label {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
