---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import TimelineEntry from "../components/TimelineEntry.astro";
import career from "../data/career.json";

type Category = keyof typeof career.categories;
type Entry = (typeof career.entries)[number];

const categories = career.categories as Record<Category, { label: string }>;

// Most recent first. Ongoing roles (end === null) sort ahead of finished ones
// that share the same start month.
const endKey = (e: Entry) => e.end ?? "9999-99";
const sorted = [...career.entries].sort(
  (a, b) => b.start.localeCompare(a.start) || endKey(b).localeCompare(endKey(a)),
);

// Group by start year so the spine can carry year markers.
const byYear: { year: string; entries: Entry[] }[] = [];
for (const e of sorted) {
  const year = e.start.slice(0, 4);
  const last = byYear[byYear.length - 1];
  if (last && last.year === year) last.entries.push(e);
  else byYear.push({ year, entries: [e] });
}

const categoryKeys = Object.keys(categories) as Category[];
const counts = Object.fromEntries(
  categoryKeys.map((c) => [c, sorted.filter((e) => e.category === c).length]),
) as Record<Category, number>;

const firstYear = sorted[sorted.length - 1].start.slice(0, 4);
const lastYear = sorted.some((e) => e.end === null)
  ? "Present"
  : sorted.reduce((m, e) => (e.end && e.end > m ? e.end : m), "").slice(0, 4);
---

<Base title="Career — Brian Epstein">
  <Nav />
  <main class="career-page">
    <div class="container">
      <header class="page-head">
        <p class="eyebrow">Career · {firstYear} – {lastYear}</p>
        <h1 class="page-title">Experience</h1>
        <p class="page-subtitle">
          Research, industry, teaching, and leadership roles at Georgia Tech and beyond, on one timeline.
          Filter by track to follow a single thread.
        </p>
      </header>

      <div class="filter-bar" role="group" aria-label="Filter timeline by category">
        <button class="chip active" data-filter="all" aria-pressed="true">
          All <span class="chip-count">{sorted.length}</span>
        </button>
        {categoryKeys.map((c) => (
          <button class:list={["chip", `cat-${c}`]} data-filter={c} aria-pressed="false">
            <span class="chip-dot" aria-hidden="true"></span>
            {categories[c].label} <span class="chip-count">{counts[c]}</span>
          </button>
        ))}
      </div>

      <ol class="timeline" id="timeline">
        {byYear.map(({ year, entries }) => (
          <li class="year-group" data-year={year}>
            <div class="year-marker" aria-hidden="true"><span>{year}</span></div>
            <ol class="year-entries">
              {entries.map((e) => (
                <TimelineEntry
                  title={e.title}
                  org={e.org}
                  dateRange={e.dateRange}
                  description={e.description}
                  category={e.category}
                  categoryLabel={categories[e.category as Category].label}
                  current={e.end === null}
                  projectLink={e.projectLink}
                />
              ))}
            </ol>
          </li>
        ))}
      </ol>

      <p class="empty-note" id="empty-note" hidden>No entries in this category.</p>
    </div>
  </main>
  <Footer />
</Base>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".chip[data-filter]"));
  const entries = Array.from(document.querySelectorAll<HTMLElement>(".timeline-entry[data-category]"));
  const groups = Array.from(document.querySelectorAll<HTMLElement>(".year-group"));
  const emptyNote = document.getElementById("empty-note");

  function applyFilter(filter: string) {
    for (const el of entries) {
      el.hidden = filter !== "all" && el.dataset.category !== filter;
    }
    let visible = 0;
    for (const g of groups) {
      const any = Array.from(g.querySelectorAll<HTMLElement>(".timeline-entry")).some((e) => !e.hidden);
      g.hidden = !any;
      if (any) visible++;
    }
    if (emptyNote) emptyNote.hidden = visible > 0;
    for (const c of chips) {
      const on = c.dataset.filter === filter;
      c.classList.toggle("active", on);
      c.setAttribute("aria-pressed", String(on));
    }
    const url = new URL(window.location.href);
    if (filter === "all") url.searchParams.delete("track");
    else url.searchParams.set("track", filter);
    history.replaceState(null, "", url);
  }

  for (const c of chips) {
    c.addEventListener("click", () => applyFilter(c.dataset.filter ?? "all"));
  }

  const initial = new URLSearchParams(window.location.search).get("track");
  if (initial && chips.some((c) => c.dataset.filter === initial)) applyFilter(initial);
</script>

<style>
  .career-page {
    padding-top: calc(86px + var(--space-lg));
    padding-bottom: var(--space-2xl);
  }

  /* ── Header (mirrors the landing page hero) ─────────────── */
  .page-head {
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-lg);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-status-complete);
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .eyebrow::before {
    content: "";
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(232, 197, 71, 0.18);
  }
  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--color-text-bright);
  }
  .page-subtitle {
    font-size: 1.02rem;
    color: var(--color-text);
    margin-top: 14px;
    max-width: 56ch;
    line-height: 1.55;
  }

  /* ── Filter chips ───────────────────────────────────────── */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--space-xl);
    position: sticky;
    top: 56px;
    z-index: 5;
    padding: 12px 0;
    background: linear-gradient(var(--color-bg) 85%, transparent);
  }
  .chip {
    --cat: var(--color-text-bright);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 7px 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    border: 1px solid var(--color-border-bright);
    color: var(--color-text);
    background: var(--color-bg-raised);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s, transform 0.15s;
  }
  .chip.cat-research    { --cat: var(--color-cat-research); }
  .chip.cat-industry    { --cat: var(--color-cat-industry); }
  .chip.cat-teaching    { --cat: var(--color-cat-teaching); }
  .chip.cat-leadership  { --cat: var(--color-cat-leadership); }
  .chip.cat-robojackets { --cat: var(--color-cat-robojackets); }
  .chip:hover {
    border-color: var(--cat);
    color: var(--color-text-bright);
    transform: translateY(-1px);
  }
  .chip.active {
    border-color: var(--cat);
    color: var(--cat);
    background: color-mix(in srgb, var(--cat) 12%, var(--color-bg-raised));
  }
  .chip-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cat);
  }
  .chip-count {
    color: var(--color-text-muted);
    font-size: 0.66rem;
  }
  .chip.active .chip-count {
    color: inherit;
    opacity: 0.75;
  }

  /* ── Single spine timeline ──────────────────────────────── */
  .timeline,
  .year-entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline {
    position: relative;
    padding-left: 96px;
  }
  .timeline::before {
    content: "";
    position: absolute;
    left: 96px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-border-bright);
  }

  .year-group {
    position: relative;
  }
  .year-marker {
    position: absolute;
    left: -96px;
    top: 0;
    width: 96px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .year-marker span {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }
  .year-marker::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--color-border-bright);
  }
  .year-group + .year-group {
    margin-top: var(--space-lg);
  }

  .empty-note {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    padding: var(--space-lg) 0;
  }

  @media (max-width: 768px) {
    .career-page {
      padding-top: calc(56px + var(--space-lg));
    }
    .filter-bar {
      position: static;
      padding: 0;
      background: none;
      margin-bottom: var(--space-lg);
    }
    .timeline {
      padding-left: 12px;
    }
    .timeline::before {
      left: 12px;
    }
    .year-group {
      padding-top: 28px;
    }
    .year-marker {
      left: -12px;
      top: 0;
      width: auto;
    }
    .year-marker span {
      background: var(--color-bg);
      padding-right: 8px;
    }
    .year-marker::after {
      display: none;
    }
  }
</style>
